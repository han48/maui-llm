<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIAgentLocal.Views.LanguagePickerPage"
             Title="Language"
             BackgroundColor="{AppThemeBinding Light=#FEFAFF, Dark=#1a1a2e}">
    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">
        <Label Text="Select Language" FontSize="20" HorizontalOptions="Center" />
        <Picker x:Name="LanguagePicker" 
                Title="Language"
                FontSize="16"
                HorizontalOptions="Fill" />
        <Button Text="OK" 
                Clicked="OnOkClicked"
                BackgroundColor="#B06AB3"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="44"
                HorizontalOptions="Fill" />
        <Button Text="Cancel" 
                Clicked="OnCancelClicked"
                BackgroundColor="Transparent"
                TextColor="#B06AB3"
                HeightRequest="44"
                HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentPage>
